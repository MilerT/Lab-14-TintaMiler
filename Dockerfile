FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY global.json .
COPY LAB10-TINTAMILER.DOMAIN/*.csproj LAB10-TINTAMILER.DOMAIN/
COPY LAB10-TINTAMILER.APPLICATION/*.csproj LAB10-TINTAMILER.APPLICATION/
COPY LAB10-TINTAMILER.INFRASTRUCTURE/*.csproj LAB10-TINTAMILER.INFRASTRUCTURE/
COPY LAB10-TINTAMILER.API/*.csproj LAB10-TINTAMILER.API/
RUN dotnet restore LAB10-TINTAMILER.API/LAB10-TINTAMILER.API.csproj
COPY . .
RUN dotnet publish LAB10-TINTAMILER.API -c Release -f net8.0 --no-restore -o /out /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /out/ .
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
USER app
ENTRYPOINT ["dotnet","LAB10-TINTAMILER.API.dll"]
